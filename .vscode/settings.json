{
  // ── Chemins locaux (poste de l'étudiant) ──
  "dotnet.defaultSolution": "MediRappel.slnx",
  "omnisharp.useModernNet": true,

  // SDK Android utilisé par le workload maui-android et l'émulateur
  "dotnet.unitTests.runSettingsPath": "",

  // XML : validation des fichiers .xaml / .axml
  "xml.fileAssociations": [
    { "pattern": "**/*.xaml", "systemId": "http://schemas.microsoft.com/dotnet/2021/maui" }
  ],

  "files.exclude": {
    "**/bin": true,
    "**/obj": true
  },
  "files.associations": {
    "*.xaml": "xml"
  },

  // Terminal : variables d'environnement Android (l'émulateur et le build les lisent)
  "terminal.integrated.env.linux": {
    "ANDROID_HOME": "/home/markitchi/android-sdk",
    "ANDROID_SDK_ROOT": "/home/markitchi/android-sdk",
    "JAVA_HOME": "/home/markitchi/.jdk",
    "PATH": "/home/markitchi/android-sdk/platform-tools:/home/markitchi/android-sdk/emulator:${env:PATH}"
  },
  "terminal.integrated.env.osx": {
    "ANDROID_HOME": "${env:HOME}/android-sdk",
    "ANDROID_SDK_ROOT": "${env:HOME}/android-sdk"
  },
  "terminal.integrated.env.windows": {
    "ANDROID_HOME": "${env:USERPROFILE}\\android-sdk",
    "ANDROID_SDK_ROOT": "${env:USERPROFILE}\\android-sdk"
  }
}
