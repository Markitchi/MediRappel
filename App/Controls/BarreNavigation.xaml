<?xml version="1.0" encoding="utf-8" ?>
<!-- Barre de navigation inférieure : 4 destinations. L'état actif est signalé
     par la forme (pastille) + le gras du label, pas par la couleur seule. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediRappel.Controls.BarreNavigation"
             x:Name="racine">
    <VerticalStackLayout Spacing="0" BackgroundColor="{StaticResource SurfaceContainer}">
        <!-- Trait supérieur -->
        <BoxView HeightRequest="1" Color="{StaticResource OutlineVariant}" />

        <Grid ColumnDefinitions="*,*,*,*" Padding="6,8,6,10" x:Name="grille">

            <VerticalStackLayout Grid.Column="0" x:Name="i0" Spacing="3"
                                 HorizontalOptions="Fill" VerticalOptions="Center">
                <Border x:Name="p0" StrokeShape="RoundRectangle 16" Padding="14,4"
                        BackgroundColor="Transparent" StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Label Text="home" FontFamily="MaterialIcons" FontSize="22"
                           x:Name="ic0" TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalOptions="Center" />
                </Border>
                <Label Text="Accueil" FontSize="11" x:Name="l0"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="1" x:Name="i1" Spacing="3"
                                 HorizontalOptions="Fill" VerticalOptions="Center">
                <Border x:Name="p1" StrokeShape="RoundRectangle 16" Padding="14,4"
                        BackgroundColor="Transparent" StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Label Text="description" FontFamily="MaterialIcons" FontSize="22"
                           x:Name="ic1" TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalOptions="Center" />
                </Border>
                <Label Text="Ordonnances" FontSize="11" x:Name="l1"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" x:Name="i2" Spacing="3"
                                 HorizontalOptions="Fill" VerticalOptions="Center">
                <Border x:Name="p2" StrokeShape="RoundRectangle 16" Padding="14,4"
                        BackgroundColor="Transparent" StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Label Text="event" FontFamily="MaterialIcons" FontSize="22"
                           x:Name="ic2" TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalOptions="Center" />
                </Border>
                <Label Text="Rendez-vous" FontSize="11" x:Name="l2"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="3" x:Name="i3" Spacing="3"
                                 HorizontalOptions="Fill" VerticalOptions="Center">
                <Border x:Name="p3" StrokeShape="RoundRectangle 16" Padding="14,4"
                        BackgroundColor="Transparent" StrokeThickness="0"
                        HorizontalOptions="Center">
                    <Label Text="history" FontFamily="MaterialIcons" FontSize="22"
                           x:Name="ic3" TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalOptions="Center" />
                </Border>
                <Label Text="Historique" FontSize="11" x:Name="l3"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </VerticalStackLayout>
</ContentView>
