<?xml version="1.0" encoding="utf-8" ?>
<!-- Écran 09 · Historique et observance — tendance calculée sur les doses réelles. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MediRappel.Vues.VueHistorique">
    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,110">

            <Label Text="Historique" Style="{StaticResource HeadlineMedium}"
                   Margin="24,14,24,0" />

            <!-- Filtres temporels -->
            <HorizontalStackLayout Spacing="8" Margin="24,12,24,0">
                <Border Style="{StaticResource Chip}" StrokeThickness="0"
                        BackgroundColor="{Binding Filtre7, Converter={StaticResource SelFond}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Filtre7Tapped" />
                    </Border.GestureRecognizers>
                    <Label Text="7 jours" FontSize="14" FontAttributes="Bold"
                           TextColor="{Binding Filtre7, Converter={StaticResource SelTexte}}"
                           VerticalOptions="Center" />
                </Border>
                <Border Style="{StaticResource Chip}" StrokeThickness="0"
                        BackgroundColor="{Binding Filtre30, Converter={StaticResource SelFond}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Filtre30Tapped" />
                    </Border.GestureRecognizers>
                    <Label Text="30 jours" FontSize="14" FontAttributes="Bold"
                           TextColor="{Binding Filtre30, Converter={StaticResource SelTexte}}"
                           VerticalOptions="Center" />
                </Border>
                <Border Style="{StaticResource Chip}" StrokeThickness="0"
                        BackgroundColor="{Binding Filtre90, Converter={StaticResource SelFond}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Filtre90Tapped" />
                    </Border.GestureRecognizers>
                    <Label Text="90 jours" FontSize="14" FontAttributes="Bold"
                           TextColor="{Binding Filtre90, Converter={StaticResource SelTexte}}"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>

            <!-- Indicateur principal -->
            <Border Style="{StaticResource Card}" Margin="24,14,24,0">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Observance du traitement" FontSize="13"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                            <Label Text="{Binding Resume}" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource OnSurface}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding ObsTexte}"
                               FontSize="34" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center" />
                    </Grid>
                    <ProgressBar Progress="{Binding ObsNorm}" ProgressColor="{StaticResource Primary}"
                                 BackgroundColor="{StaticResource SurfaceHigh}"
                                 Margin="0,14,0,0" HeightRequest="8" />
                    <Label Text="{Binding NonPrises}" FontSize="12" Margin="0,10,0,0"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <!-- Graphique par semaine -->
            <Label Text="Par semaine" Style="{StaticResource TitleLarge}"
                   Margin="24,22,24,0" />
            <Border Style="{StaticResource Card}" Margin="24,10,24,0">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Prises par semaine"
                               FontSize="12" FontAttributes="Bold" CharacterSpacing="0.8"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding PeriodeTexte}"
                               FontSize="12" TextColor="{StaticResource OnSurfaceVariant}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- État vide -->
                    <Label Text="Aucune prise enregistrée sur cette période."
                           IsVisible="{Binding Vide}"
                           FontSize="13" TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalTextAlignment="Center" Margin="0,24" />

                    <!-- Histogramme : une colonne par semaine, largeurs égales -->
                    <FlexLayout Direction="Row" Wrap="NoWrap"
                                IsVisible="{Binding NonVide}"
                                BindableLayout.ItemsSource="{Binding Semaines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid FlexLayout.Grow="1" FlexLayout.Basis="0"
                                      RowDefinitions="Auto,*,Auto" HeightRequest="140">
                                    <Label Grid.Row="0" Text="{Binding PourcentTexte}" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           HorizontalTextAlignment="Center" />
                                    <Border Grid.Row="1" VerticalOptions="End"
                                            BackgroundColor="{Binding Tendance, Converter={StaticResource TendanceCouleur}}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 6"
                                            WidthRequest="22" HorizontalOptions="Center"
                                            HeightRequest="{Binding HauteurBarre}" />
                                    <Label Grid.Row="2" Text="{Binding LibelleCourt}" FontSize="10"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Légende : la couleur est toujours doublée d'un libellé -->
                    <HorizontalStackLayout Spacing="14" IsVisible="{Binding NonVide}">
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                     Color="{StaticResource Primary}" VerticalOptions="Center" />
                            <Label Text="Validées" FontSize="11"
                                   TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                     Color="{StaticResource BarrePartielle}" VerticalOptions="Center" />
                            <Label Text="Partielles" FontSize="11"
                                   TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="5">
                            <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="5"
                                     Color="{StaticResource Error}" VerticalOptions="Center" />
                            <Label Text="Manquées" FontSize="11"
                                   TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>

                    <Label Text="{Binding NonPrises}" FontSize="11" IsVisible="{Binding NonVide}"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <!-- Détail par semaine -->
            <Label Text="Détail" Style="{StaticResource TitleLarge}"
                   Margin="24,22,24,0" />
            <VerticalStackLayout Spacing="8" Margin="24,10,24,0"
                                 IsVisible="{Binding NonVide}"
                                 BindableLayout.ItemsSource="{Binding Semaines}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="0,8" ColumnSpacing="10">
                            <BoxView Grid.Column="0" WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                     Color="{Binding Tendance, Converter={StaticResource TendanceCouleur}}"
                                     VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Libelle}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource OnSurface}" />
                                <Label Text="{Binding Compteur}" FontSize="12"
                                       TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding PourcentTexte}"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Export -->
            <Button Text="Exporter l'historique (CSV)"
                    Clicked="Exporter"
                    Margin="24,22,24,0"
                    BackgroundColor="{StaticResource SecondaryContainer}"
                    TextColor="{StaticResource OnSecondaryContainer}"
                    CornerRadius="14" HeightRequest="50"
                    FontAttributes="Bold" />
            <Label Text="L'export est enregistré sur l'appareil puis partagé par vos soins. Rien n'est envoyé automatiquement."
                   FontSize="11" TextColor="{StaticResource OnSurfaceVariant}"
                   Margin="24,10,24,0" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
