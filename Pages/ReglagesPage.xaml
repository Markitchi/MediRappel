<?xml version="1.0" encoding="utf-8" ?>
<!-- Écran 10 · Réglages — profil réel, synchronisation et confidentialité. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:MediRappel.Controls"
             x:Class="MediRappel.Pages.ReglagesPage"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,Auto,*">
        <c:BarreSysteme Grid.Row="0" x:Name="barre" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Padding="12,4,16,6" ColumnSpacing="6">
            <Label Grid.Column="0" Text="arrow_back" FontFamily="MaterialIcons" FontSize="24"
                   TextColor="{StaticResource OnSurface}" Padding="8" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="Retour" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Réglages" Style="{StaticResource TitleLarge}"
                   VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="24,4,24,24" Spacing="0">

                <!-- Profil -->
                <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource PrimaryContainer}"
                        Stroke="Transparent" Padding="16,14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" BackgroundColor="{StaticResource Primary}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 24"
                                WidthRequest="48" HeightRequest="48" VerticalOptions="Center">
                            <Label Text="{Binding Initiales}" FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource OnPrimary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding Nom}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource OnPrimaryContainer}" />
                            <Label Text="{Binding Email}" FontSize="12"
                                   TextColor="{StaticResource OnPrimaryContainer}" />
                            <Label Text="{Binding Depuis}" FontSize="11"
                                   TextColor="{StaticResource OnPrimaryContainer}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Réseau et données -->
                <Label Text="Connexion et données" Style="{StaticResource TitleLarge}"
                       Margin="0,22,0,0" />
                <VerticalStackLayout Spacing="8" Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}" Padding="14,13">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="{Binding IconeReseau}" FontFamily="MaterialIcons"
                                   FontSize="20" TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="État de la connexion" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding EtatReseau}" FontSize="12"
                                       TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14,13">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="wifi" FontFamily="MaterialIcons"
                                   FontSize="20" TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Synchroniser en Wi-Fi uniquement" FontSize="15"
                                       FontAttributes="Bold" />
                                <Label Text="Éviter la data mobile" FontSize="12"
                                       TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" IsToggled="{Binding SyncWifi, Mode=OneWay}"
                                    OnColor="{StaticResource Primary}"
                                    Toggled="SyncWifiToggled"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14,13">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="CacheTape" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="storage" FontFamily="MaterialIcons"
                                   FontSize="20" TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Espace utilisé" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding TailleCache}" FontSize="12"
                                       TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="delete_sweep" FontFamily="MaterialIcons"
                                   FontSize="20" TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Rappels -->
                <Label Text="Rappels et notifications" Style="{StaticResource TitleLarge}"
                       Margin="0,22,0,0" />
                <VerticalStackLayout Spacing="8" Margin="0,10,0,0">
                    <Border Style="{StaticResource Card}" Padding="14,13">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="notifications" FontFamily="MaterialIcons"
                                   FontSize="20" TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Rappels de prise" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding ResumeRappels}" FontSize="12"
                                       TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" IsToggled="{Binding RappelsActifs, Mode=OneWay}"
                                    OnColor="{StaticResource Primary}"
                                    Toggled="RappelsToggled"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="14,13">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="PlageTapee" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0" Text="bedtime" FontFamily="MaterialIcons"
                                   FontSize="20" TextColor="{StaticResource Primary}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Plage de silence" FontSize="15" FontAttributes="Bold" />
                                <Label Text="{Binding PlageSilence}" FontSize="12"
                                       TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="chevron_right" FontFamily="MaterialIcons"
                                   FontSize="22" TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Confidentialité -->
                <Label Text="Confidentialité" Style="{StaticResource TitleLarge}"
                       Margin="0,22,0,0" />
                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,13">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="lock" FontFamily="MaterialIcons"
                               FontSize="20" TextColor="{StaticResource Primary}"
                               VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Verrouillage de l'application" FontSize="15"
                                   FontAttributes="Bold" />
                            <Label Text="Protéger l'accès au dossier" FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="2" IsToggled="{Binding Verrouillage, Mode=OneWay}"
                                OnColor="{StaticResource Primary}"
                                Toggled="VerrouillageToggled"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Label FontSize="12" TextColor="{StaticResource OnSurfaceVariant}"
                       Margin="0,18,0,0" HorizontalTextAlignment="Center"
                       Text="Vos données sont synchronisées avec votre compte. Aucun partage ne se fait sans votre action." />

                <Button Text="Se déconnecter" Style="{StaticResource BtnTonal}"
                        Margin="0,20,0,0" Clicked="Deconnecter" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
