<?xml version="1.0" encoding="utf-8" ?>
<!-- Écran 01 · Connexion — accès au dossier, y compris pour reprendre une session. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:MediRappel.Controls"
             x:Class="MediRappel.Pages.ConnexionPage"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,28" Spacing="0">
            <c:BarreSysteme x:Name="barre" />

            <VerticalStackLayout Padding="24,8,24,0" Spacing="0">
                <!-- Marque -->
                <Label Text="MediRappel" Style="{StaticResource DisplaySmall}"
                       TextColor="{StaticResource Primary}" />
                <Label Text="Votre traitement, bien suivi"
                       FontSize="13" FontAttributes="Bold"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       Margin="0,4,0,0" />

                <!-- Promesse -->
                <Label Text="Vos ordonnances. Vos rappels. Toujours."
                       Style="{StaticResource HeadlineSmall}"
                       Margin="0,24,0,0" />
                <Label Style="{StaticResource BodyMedium}"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       Margin="0,8,0,0">
                    Retrouvez vos ordonnances, vos rendez-vous et le suivi de vos prises
                    sur tous vos appareils. Vos rappels restent consultables hors connexion.
                </Label>

                <!-- Formulaire -->
                <VerticalStackLayout Spacing="18" Margin="0,26,0,0">
                    <c:ChampTexte Libelle="Adresse e-mail"
                                  Valeur="{Binding Email, Mode=TwoWay}"
                                  Indice="vous@exemple.fr"
                                  CleClavier="Email"
                                  OeilVisible="False"
                                  Erreur="Adresse e-mail invalide."
                                  ErreurVisible="{Binding EmailErreur}" />

                    <c:ChampTexte Libelle="Mot de passe"
                                  Valeur="{Binding Mdp, Mode=TwoWay}"
                                  Indice="••••••••"
                                  MotDePasse="True"
                                  OeilVisible="True" />
                </VerticalStackLayout>

                <!-- Message d'erreur serveur -->
                <Border BackgroundColor="{StaticResource MissedContainer}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        Padding="14,12" Margin="0,16,0,0"
                        IsVisible="{Binding ErreurVisible}">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="error" FontFamily="MaterialIcons" FontSize="18"
                               TextColor="{StaticResource OnMissedContainer}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding ErreurMessage}" FontSize="13"
                               TextColor="{StaticResource OnMissedContainer}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Se souvenir / récupération -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8">
                        <CheckBox IsChecked="{Binding Souvenir, Mode=TwoWay}"
                                  VerticalOptions="Center" />
                        <Label Text="Se souvenir de moi"
                               Style="{StaticResource BodyMedium}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="2"
                           Text="Mot de passe oublié ?"
                           FontSize="13" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OubliMdp" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Confidentialité -->
                <Border BackgroundColor="{StaticResource SecondaryContainer}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        Padding="14,12" Margin="0,22,0,0">
                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="7">
                            <Label Text="lock" FontFamily="MaterialIcons" FontSize="17"
                                   TextColor="{StaticResource OnSecondaryContainer}"
                                   VerticalOptions="Center" />
                            <Label Text="Votre dossier est protégé."
                                   FontSize="13" FontAttributes="Bold"
                                   TextColor="{StaticResource OnSecondaryContainer}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label FontSize="12"
                               TextColor="{StaticResource OnSecondaryContainer}"
                               Text="Vos données sont rattachées à votre compte et accessibles hors connexion sur cet appareil. Aucun partage n'a lieu sans votre action." />
                    </VerticalStackLayout>
                </Border>

                <!-- Action -->
                <Button Text="{Binding BoutonTexte}"
                        Style="{StaticResource BtnPrimary}"
                        Margin="0,24,0,0"
                        IsEnabled="{Binding NonOccupe}"
                        Clicked="Connexion" />

                <!-- Lien d'inscription -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,16,0,0">
                    <Label Text="Pas encore de compte ?" Style="{StaticResource BodyMedium}"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                    <Label Text="Créer un compte" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="VersInscription" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <Label FontSize="11" TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalTextAlignment="Center" Margin="0,18,0,0"
                       Text="Compte d'évaluation : test@medirappel.fr · test1234" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
