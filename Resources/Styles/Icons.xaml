<?xml version="1.0" encoding="utf-8" ?>
<!-- Utilisation : <Label ... FontFamily="MaterialIcons" Text="home" /> -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Icônes Material Design (24 px grid) -->
    <Style x:Key="Mi" TargetType="Label">
        <Setter Property="FontFamily" Value="MaterialIcons" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="MiSm" TargetType="Label" BasedOn="{StaticResource Mi}">
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="MiLg" TargetType="Label" BasedOn="{StaticResource Mi}">
        <Setter Property="FontSize" Value="24" />
    </Style>

    <Style x:Key="MiXl" TargetType="Label" BasedOn="{StaticResource Mi}">
        <Setter Property="FontSize" Value="30" />
    </Style>

</ResourceDictionary>
